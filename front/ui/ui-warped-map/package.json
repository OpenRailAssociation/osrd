{
  "name": "@osrd-project/ui-warped-map",
  "description": "A React component to display MapLibre maps warped along a given path.",
  "version": "0.0.1-dev",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/OpenRailAssociation/osrd/tree/dev/front/ui/ui-warped-map#readme",
