{
  "printWidth": 100,
  "singleQuote": true,
  "arrowParens": "always",
  "proseWrap": "always",
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.md",
    "public/locales/en/infraEditor.json",
    "src/applications/operationalStudies/views/Scenario/components/ImportTrainSchedule/rollingstock_opendata2osrd.json",
    "src/assets/mapstyles/*.json",
    "src/common/NavBar/json/licenses.json",
    "src/reducers/osrdconf/infra_schema.json",
    "src/utils/__tests__/assets/*.json",
    "/ui",
    "node_modules"
  ],
  "sortImports": {
    "groups": [
      "react",
      "builtin",
      ["external", "nge"],
      "external_styles",
      ["internal", "bare_internal"],
      ["index", "sibling", "parent"],
      ["style", "side_effect_style"]
    ],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"]
      },
      {
        "groupName": "bare_internal",
        "elementNamePattern": ["reducers", "store", "types"]
      },
      {
        "groupName": "nge",
        "elementNamePattern": ["@osrd-project/netzgrafik-frontend/dist/**/*"]
      },
      {
        "groupName": "external_styles",
        "elementNamePattern": ["**/dist/**/*.{css,scss}", "**/vendor/**/*.{css,scss}"]
      }
    ],
    "internalPattern": [
      "applications/",
      "assets/",
      "common/",
      "config/",
      "main/",
      "modules/",
      "reducers/",
      "styles/",
      "test-data/",
      "utils/"
    ],
    "newlinesBetween": true,
    "ignoreCase": true
  }
}
