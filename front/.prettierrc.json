{
  "printWidth": 100,
  "singleQuote": true,
  "arrowParens": "always",
  "proseWrap": "always",
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.jsonc", ".eslintrc", "tsconfig*.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
