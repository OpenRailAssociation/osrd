{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "jsx-a11y", "react", "typescript", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "es2018": true
  },
  "jsPlugins": [
    {
      "name": "import-js",
      "specifier": "eslint-plugin-import"
    }
  ],
  "ignorePatterns": [
    "src/common/api/generatedEditoastApi.ts",
    "src/common/api/osrdGatewayApi.ts",
    "src/common/api/osrdRailwayManagerApi.ts",
    "public",
    "build",
    "playwright-report",
    "**/ui-icons/src/**",
    "**/dist/**",
    "**/storybook-static/**"
  ],
  "rules": {
    "array-callback-return": "off",
    "await-thenable": "off",
    "checked-requires-onchange-or-readonly": "off",
    "click-events-have-key-events": "off",
    "consistent-return": "off",
    "control-has-associated-label": "off",
    "eslint/require-await": "off",
    "exhaustive-deps": "off",
    "iframe-missing-sandbox": "off",
    "max-classes-per-file": "off",
    "max-dependencies": "off",
    "max-depth": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "no-array-index-key": "off",
    "no-await-in-loop": "off",
    "no-base-to-string": "off",
    "no-confusing-non-null-assertion": "off",
    "no-confusing-void-expression": "off",
    "no-duplicate-type-constituents": "off",
    "no-else-return": "off",
    "no-floating-promises": "off",
    "no-inline-comments": "off",
    "no-lonely-if": "off",
    "no-loop-func": "off",
    "no-misused-promises": "off",
    "no-misused-spread": "off",
    "no-named-as-default-member": "off",
    "no-named-as-default": "off",
    "no-negated-condition": "off",
    "no-redundant-type-constituents": "off",
    "no-throw-literal": "off",
    "no-unassigned-import": "off",
    "no-underscore-dangle": "off",
    "no-unnecessary-boolean-literal-compare": "off",
    "no-unnecessary-template-expression": "off",
    "no-unnecessary-type-arguments": "off",
    "no-unnecessary-type-conversion": "off",
    "no-unnecessary-type-parameters": "off",
    "no-unsafe-argument": "off",
    "no-unsafe-assignment": "off",
    "no-unsafe-enum-comparison": "off",
    "no-unsafe-member-access": "off",
    "no-unsafe-optional-chaining": "off",
    "no-unsafe-type-assertion": "off",
    "no-useless-constructor": "off",
    "no-useless-default-assignment": "off",
    "no-useless-return": "off",
    "no-warning-comments": "off",
    "only-throw-error": "off",
    "prefer-enum-initializers": "off",
    "prefer-includes": "off",
    "prefer-nullish-coalescing": "off",
    "prefer-readonly-parameter-types": "off",
    "prefer-tag-over-role": "off",
    "preserve-caught-error": "off",
    "radix": "off",
    "react-in-jsx-scope": "off",
    "require-array-sort-compare": "off",
    "require-mock-type-parameters": "off",
    "require-unicode-regexp": "off",
    "restrict-template-expressions": "off",
    "return-await": "off",
    "strict-boolean-expressions": "off",
    "strict-void-return": "off",
    "switch-exhaustiveness-check": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/require-await": "off",
    "unbound-method": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-disabled-tests": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-to-throw-message": "off",

    "export": "error",
    "no-duplicates": "error",
    "no-empty-object-type": "error",
    "no-empty": "error",
    "no-explicit-any": "error",
    "no-import-node-test": "error",
    "no-regex-spaces": "error",
    "no-require-imports": "error",
    "no-undef": "error",
    "no-unknown-property": "error",
    "no-use-before-define": "error",
    "non-nullable-type-assertion-style": "error",
    "prefer-called-exactly-once-with": "error",
    "require-render-return": "error",
    "vitest/no-identical-title": "error",

    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/no-redundant-roles": "error",

    "arrow-body-style": ["error", "as-needed"],
    "import/extensions": [
      "error",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never",
        "ignorePackages": true
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": [],
        "roles": ["tabpanel"],
        "allowExpressionValues": true
      }
    ],
    "jsx-a11y/no-static-element-interactions": [
      "error",
      {
        "allowExpressionValues": true,
        "handlers": ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["info", "debug", "warn", "error"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "name": "common/api/generatedEditoastApi",
        "message": "Please use common/api/osrdEditoastApi instead"
      }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "LegacyFilterSpecification": {
            "message": "Use ExpressionFilterSpecification instead",
            "fixWith": "ExpressionFilterSpecification"
          },
          "FC": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FC": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FunctionComponent": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FunctionalComponent": "Preact specific, useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177"
        }
      }
    ],

    "import-js/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/__mocks__/**",
          "**/__tests__/**",
          "**/.storybook/**",
          "**/*.spec.ts",
          "**/*.spec.tsx",
          "**/build.js",
          "**/playwright.config.ts",
          "**/rollup.config.js",
          "**/scripts/**",
          "**/tests/**",
          "**/vite.config.ts",
          "**/vitest.config.mts",
          "**/vitest.setup.ts",
          "rollup-base.config.js"
        ]
      }
    ],

    "react/capitalized-calls": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/hooks": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",

    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error"
  },
  "settings": {
    "react": {
      "version": "19.2.4"
    }
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "no-redeclare": "off",
        "no-undef": "off",
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": ["tests/**/*.ts", "tests/**/*.tsx"],
      "rules": {
        "react/rules-of-hooks": "off",
        "typescript/no-floating-promises": "error"
      }
    },
    {
      "files": ["ui/**/*", "**/front/ui/**/*"],
      "rules": {
        "import/no-named-as-default": "warn",
        "import/no-named-as-default-member": "warn",

        "react/capitalized-calls": "error",
        "react/exhaustive-deps": "warn",
        "react/exhaustive-effect-dependencies": "error",
        "react/hooks": "error",
        "react/memo-dependencies": "error",
        "react/preserve-manual-memoization": "error",
        "react/react-in-jsx-scope": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",

        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/no-static-element-interactions": "off",

        "typescript/consistent-type-definitions": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/non-nullable-type-assertion-style": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",

        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@osrd-project/*/src/*", "*/ui-*/src/*"]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.stories.{ts,tsx,js,jsx,mjs,cjs}",
        "**/*.stories.@(ts|tsx|js|jsx|mjs|cjs)",
        "**/*.story.@(ts|tsx|js|jsx|mjs|cjs)"
      ],
      "rules": {
        "storybook/await-interactions": "error",
        "storybook/context-in-play-function": "error",
        "storybook/default-exports": "error",
        "storybook/hierarchy-separator": "warn",
        "storybook/no-redundant-story-name": "warn",
        "storybook/no-renderer-packages": "error",
        "storybook/prefer-pascal-case": "warn",
        "storybook/story-exports": "error",
        "storybook/use-storybook-expect": "error",
        "storybook/use-storybook-testing-library": "error",
        "react/rules-of-hooks": "off"
      },
      "jsPlugins": ["eslint-plugin-storybook"]
    },
    {
      "files": [".storybook/main.@(js|cjs|mjs|ts)"],
      "rules": {
        "storybook/no-uninstalled-addons": "error"
      },
      "jsPlugins": ["eslint-plugin-storybook"]
    },
    {
      "files": ["rollup-base.config.js"],
      "rules": {
        "import-js/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true,
            "packageDir": ["./base", "./ui/base"]
          }
        ]
      }
    },
    {
      "files": ["scripts/**/*", "tests/reporter/**/*"],
      "rules": {
        "import/extensions": ["error", "ignorePackages"]
      }
    }
  ]
}
