{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "jsx-a11y", "react", "typescript", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "es2018": true
  },
  "jsPlugins": [
    {
      "name": "import-js",
      "specifier": "eslint-plugin-import"
    }
  ],
  "ignorePatterns": [
    "src/common/api/generatedEditoastApi.ts",
    "src/common/api/osrdGatewayApi.ts",
    "src/common/api/osrdRailwayManagerApi.ts",
    "public",
    "build",
    "playwright-report",
    "**/ui-icons/src/**",
    "**/dist/**",
    "**/storybook-static/**"
  ],
  "rules": {
    "accessor-pairs": "off",
    "adjacent-overload-signatures": "off",
    "array-callback-return": "off",
    "array-type": "off",
    "await-thenable": "off",
    "ban-tslint-comment": "off",
    "ban-types": "off",
    "block-scoped-var": "off",
    "capitalized-comments": "off",
    "checked-requires-onchange-or-readonly": "off",
    "class-literal-property-style": "off",
    "click-events-have-key-events": "off",
    "consistent-each-for": "off",
    "consistent-generic-constructors": "off",
    "consistent-indexed-object-style": "off",
    "consistent-return": "off",
    "consistent-test-filename": "off",
    "consistent-test-it": "off",
    "consistent-type-assertions": "off",
    "consistent-type-exports": "off",
    "consistent-type-specifier-style": "off",
    "consistent-vitest-vi": "off",
    "control-has-associated-label": "off",
    "curly": "off",
    "default-case-last": "off",
    "default-param-last": "off",
    "dot-notation": "off",
    "eslint/require-await": "off",
    "exhaustive-deps": "off",
    "exports-last": "off",
    "first": "off",
    "forward-ref-uses-ref": "off",
    "func-name-matching": "off",
    "func-names": "off",
    "func-style": "off",
    "group-exports": "off",
    "grouped-accessor-pairs": "off",
    "guard-for-in": "off",
    "hoisted-apis-on-top": "off",
    "hook-use-state": "off",
    "id-length": "off",
    "iframe-missing-sandbox": "off",
    "init-declarations": "off",
    "jest/no-conditional-expect": "off",
    "jest/no-conditional-in-test": "off",
    "jest/no-disabled-tests": "off",
    "jsx-boolean-value": "off",
    "jsx-curly-brace-presence": "off",
    "jsx-fragments": "off",
    "jsx-handler-names": "off",
    "jsx-max-depth": "off",
    "jsx-no-constructed-context-values": "off",
    "jsx-no-script-url": "off",
    "jsx-pascal-case": "off",
    "jsx-props-no-spread-multi": "off",
    "jsx-props-no-spreading": "off",
    "lang": "off",
    "logical-assignment-operators": "off",
    "max-classes-per-file": "off",
    "max-dependencies": "off",
    "max-depth": "off",
    "max-expects": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-nested-callbacks": "off",
    "max-nested-describe": "off",
    "max-params": "off",
    "max-statements": "off",
    "new-cap": "off",
    "no-absolute-path": "off",
    "no-alias-methods": "off",
    "no-anonymous-default-export": "off",
    "no-aria-hidden-on-focusable": "off",
    "no-array-delete": "off",
    "no-array-index-key": "off",
    "no-await-in-loop": "off",
    "no-base-to-string": "off",
    "no-caller": "off",
    "no-conditional-tests": "off",
    "no-confusing-non-null-assertion": "off",
    "no-confusing-void-expression": "off",
    "no-constructor-return": "off",
    "no-continue": "off",
    "no-did-mount-set-state": "off",
    "no-did-update-set-state": "off",
    "no-duplicate-hooks": "off",
    "no-duplicate-imports": "off",
    "no-duplicate-type-constituents": "off",
    "no-else-return": "off",
    "no-empty-interface": "off",
    "no-empty-named-blocks": "off",
    "no-eval": "off",
    "no-extend-native": "off",
    "no-extra-bind": "off",
    "no-extra-label": "off",
    "no-extraneous-class": "off",
    "no-floating-promises": "off",
    "no-focused-tests": "off",
    "no-for-in-array": "off",
    "no-hooks": "off",
    "no-implicit-coercion": "off",
    "no-implied-eval": "off",
    "no-importing-vitest-globals": "off",
    "no-inferrable-types": "off",
    "no-inline-comments": "off",
    "no-inner-declarations": "off",
    "no-interpolation-in-snapshots": "off",
    "no-iterator": "off",
    "no-label-var": "off",
    "no-labels": "off",
    "no-large-snapshots": "off",
    "no-lone-blocks": "off",
    "no-lonely-if": "off",
    "no-loop-func": "off",
    "no-magic-numbers": "off",
    "no-meaningless-void-operator": "off",
    "no-misused-promises": "off",
    "no-misused-spread": "off",
    "no-mixed-enums": "off",
    "no-mocks-import": "off",
    "no-multi-assign": "off",
    "no-multi-str": "off",
    "no-mutable-exports": "off",
    "no-named-as-default-member": "off",
    "no-named-as-default": "off",
    "no-named-default": "off",
    "no-named-export": "off",
    "no-negated-condition": "off",
    "no-nested-ternary": "off",
    "no-new-func": "off",
    "no-new-wrappers": "off",
    "no-new": "off",
    "no-nodejs-modules": "off",
    "no-nonoctal-decimal-escape": "off",
    "no-object-constructor": "off",
    "no-promise-executor-return": "off",
    "no-redundant-should-component-update": "off",
    "no-redundant-type-constituents": "off",
    "no-restricted-matchers": "off",
    "no-restricted-vi-methods": "off",
    "no-return-assign": "off",
    "no-script-url": "off",
    "no-self-compare": "off",
    "no-self-import": "off",
    "no-set-state": "off",
    "no-standalone-expect": "off",
    "no-template-curly-in-string": "off",
    "no-ternary": "off",
    "no-test-prefixes": "off",
    "no-test-return-statement": "off",
    "no-this-in-sfc": "off",
    "no-throw-literal": "off",
    "no-unassigned-import": "off",
    "no-unassigned-vars": "off",
    "no-underscore-dangle": "off",
    "no-unmodified-loop-condition": "off",
    "no-unnecessary-boolean-literal-compare": "off",
    "no-unnecessary-parameter-property-assignment": "off",
    "no-unnecessary-qualifier": "off",
    "no-unnecessary-template-expression": "off",
    "no-unnecessary-type-arguments": "off",
    "no-unnecessary-type-conversion": "off",
    "no-unnecessary-type-parameters": "off",
    "no-unneeded-async-expect-function": "off",
    "no-unneeded-ternary": "off",
    "no-unsafe-argument": "off",
    "no-unsafe-assignment": "off",
    "no-unsafe-enum-comparison": "off",
    "no-unsafe-member-access": "off",
    "no-unsafe-optional-chaining": "off",
    "no-unsafe-type-assertion": "off",
    "no-unsafe-unary-minus": "off",
    "no-unsafe": "off",
    "no-useless-call": "off",
    "no-useless-computed-key": "off",
    "no-useless-concat": "off",
    "no-useless-constructor": "off",
    "no-useless-default-assignment": "off",
    "no-useless-empty-export": "off",
    "no-useless-rename": "off",
    "no-useless-return": "off",
    "no-warning-comments": "off",
    "no-will-update-set-state": "off",
    "object-shorthand": "off",
    "only-throw-error": "off",
    "operator-assignment": "off",
    "parameter-properties": "off",
    "prefer-arrow-callback": "off",
    "prefer-called-once": "off",
    "prefer-called-times": "off",
    "prefer-called-with": "off",
    "prefer-comparison-matcher": "off",
    "prefer-const": "off",
    "prefer-default-export": "off",
    "prefer-describe-function-title": "off",
    "prefer-destructuring": "off",
    "prefer-each": "off",
    "prefer-enum-initializers": "off",
    "prefer-equality-matcher": "off",
    "prefer-es6-class": "off",
    "prefer-expect-assertions": "off",
    "prefer-expect-resolves": "off",
    "prefer-expect-type-of": "off",
    "prefer-exponentiation-operator": "off",
    "prefer-find": "off",
    "prefer-for-of": "off",
    "prefer-function-type": "off",
    "prefer-hooks-in-order": "off",
    "prefer-hooks-on-top": "off",
    "prefer-import-in-mock": "off",
    "prefer-importing-vitest-globals": "off",
    "prefer-includes": "off",
    "prefer-lowercase-title": "off",
    "prefer-mock-promise-shorthand": "off",
    "prefer-mock-return-shorthand": "off",
    "prefer-nullish-coalescing": "off",
    "prefer-numeric-literals": "off",
    "prefer-object-has-own": "off",
    "prefer-object-spread": "off",
    "prefer-readonly-parameter-types": "off",
    "prefer-readonly": "off",
    "prefer-reduce-type-parameter": "off",
    "prefer-regex-literals": "off",
    "prefer-regexp-exec": "off",
    "prefer-rest-params": "off",
    "prefer-return-this-type": "off",
    "prefer-snapshot-hint": "off",
    "prefer-spread": "off",
    "prefer-spy-on": "off",
    "prefer-strict-boolean-matchers": "off",
    "prefer-strict-equal": "off",
    "prefer-tag-over-role": "off",
    "prefer-template": "off",
    "prefer-to-be-falsy": "off",
    "prefer-to-be-object": "off",
    "prefer-to-be-truthy": "off",
    "prefer-to-be": "off",
    "prefer-to-contain": "off",
    "prefer-to-have-been-called-times": "off",
    "prefer-to-have-length": "off",
    "prefer-todo": "off",
    "prefer-ts-expect-error": "off",
    "preserve-caught-error": "off",
    "radix": "off",
    "react-in-jsx-scope": "off",
    "related-getter-setter-pairs": "off",
    "require-array-sort-compare": "off",
    "require-awaited-expect-poll": "off",
    "require-hook": "off",
    "require-mock-type-parameters": "off",
    "require-to-throw-message": "off",
    "require-top-level-describe": "off",
    "require-unicode-regexp": "off",
    "restrict-plus-operands": "off",
    "restrict-template-expressions": "off",
    "return-await": "off",
    "self-closing-comp": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "sort-vars": "off",
    "state-in-constructor": "off",
    "strict-boolean-expressions": "off",
    "strict-void-return": "off",
    "style-prop-object": "off",
    "switch-exhaustiveness-check": "off",
    "symbol-description": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/require-await": "off",
    "unbound-method": "off",
    "unified-signatures": "off",
    "valid-expect-in-promise": "off",
    "vars-on-top": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-disabled-tests": "off",
    "vitest/no-focused-tests": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/prefer-snapshot-hint": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/valid-expect-in-promise": "off",
    "void-dom-elements-no-children": "off",
    "warn-todo": "off",
    "yoda": "off",

    "export": "error",
    "no-duplicates": "error",
    "no-empty-object-type": "error",
    "no-empty": "error",
    "no-explicit-any": "error",
    "no-import-node-test": "error",
    "no-regex-spaces": "error",
    "no-require-imports": "error",
    "no-undef": "error",
    "no-unknown-property": "error",
    "no-use-before-define": "error",
    "non-nullable-type-assertion-style": "error",
    "prefer-called-exactly-once-with": "error",
    "require-render-return": "error",
    "vitest/no-identical-title": "error",

    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/no-redundant-roles": "error",

    "arrow-body-style": ["error", "as-needed"],
    "import/extensions": [
      "error",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never",
        "ignorePackages": true
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": [],
        "roles": ["tabpanel"],
        "allowExpressionValues": true
      }
    ],
    "jsx-a11y/no-static-element-interactions": [
      "error",
      {
        "allowExpressionValues": true,
        "handlers": ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["info", "debug", "warn", "error"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "name": "common/api/generatedEditoastApi",
        "message": "Please use common/api/osrdEditoastApi instead"
      }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "LegacyFilterSpecification": {
            "message": "Use ExpressionFilterSpecification instead",
            "fixWith": "ExpressionFilterSpecification"
          },
          "FC": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FC": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FunctionComponent": "Useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177",
          "React.FunctionalComponent": "Preact specific, useless and has some drawbacks, see https://github.com/facebook/create-react-app/pull/8177"
        }
      }
    ],

    "import-js/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/__mocks__/**",
          "**/__tests__/**",
          "**/.storybook/**",
          "**/*.spec.ts",
          "**/*.spec.tsx",
          "**/build.js",
          "**/playwright.config.ts",
          "**/scripts/**",
          "**/tests/**",
          "**/vite.config.ts",
          "**/vitest.config.mts",
          "**/vitest.setup.ts"
        ]
      }
    ],

    "react/capitalized-calls": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/hooks": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",

    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error"
  },
  "settings": {
    "react": {
      "version": "19.2.4"
    }
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-undef": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": ["tests/**/*.ts", "tests/**/*.tsx"],
      "rules": {
        "react/rules-of-hooks": "off",
        "typescript/no-floating-promises": "error"
      }
    },
    {
      "files": ["ui/**/*", "**/front/ui/**/*"],
      "rules": {
        "import/no-named-as-default": "warn",
        "import/no-named-as-default-member": "warn",

        "react/capitalized-calls": "error",
        "react/exhaustive-deps": "warn",
        "react/exhaustive-effect-dependencies": "error",
        "react/hooks": "error",
        "react/memo-dependencies": "error",
        "react/preserve-manual-memoization": "error",
        "react/react-in-jsx-scope": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",

        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/no-static-element-interactions": "off",

        "typescript/consistent-type-definitions": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/non-nullable-type-assertion-style": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",

        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@osrd-project/*/src/*", "*/ui-*/src/*"]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.stories.{ts,tsx,js,jsx,mjs,cjs}",
        "**/*.stories.@(ts|tsx|js|jsx|mjs|cjs)",
        "**/*.story.@(ts|tsx|js|jsx|mjs|cjs)"
      ],
      "rules": {
        "storybook/await-interactions": "error",
        "storybook/context-in-play-function": "error",
        "storybook/default-exports": "error",
        "storybook/hierarchy-separator": "warn",
        "storybook/no-redundant-story-name": "warn",
        "storybook/no-renderer-packages": "error",
        "storybook/prefer-pascal-case": "warn",
        "storybook/story-exports": "error",
        "storybook/use-storybook-expect": "error",
        "storybook/use-storybook-testing-library": "error",
        "import/no-anonymous-default-export": "off",
        "react/rules-of-hooks": "off"
      },
      "jsPlugins": ["eslint-plugin-storybook"]
    },
    {
      "files": [".storybook/main.@(js|cjs|mjs|ts)"],
      "rules": {
        "storybook/no-uninstalled-addons": "error"
      },
      "jsPlugins": ["eslint-plugin-storybook"]
    },
    {
      "files": ["scripts/**/*", "tests/reporter/**/*"],
      "rules": {
        "import/extensions": ["error", "ignorePackages"]
      }
    }
  ]
}
