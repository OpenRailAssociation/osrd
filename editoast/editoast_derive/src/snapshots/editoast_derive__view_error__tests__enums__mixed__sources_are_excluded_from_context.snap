// Source
// -----------------------------------------------------------------------------

#[view_error(context)]
enum Sources {
    #[error("implicit source")]
    Implicit { source: std::io::Error, context: String },
    #[error("explicit source")]
    Explicit { #[source] my_error: std::io::Error, context: String },
    #[error("inline #[from], inferred as source")]
    From(#[from] std::io::Error),
    #[error(transparent)]
    Transparent(std::io::Error),
    #[error("derive_more conversion without #[source], not a source error")]
    #[from(InnerError)]
    DeriveMore(InnerError),
}

// Macro expansion
// -----------------------------------------------------------------------------

impl crate::views::error::ViewError for Sources {
    fn label(&self) -> &'static str {
        match self {
            Self::Implicit { source: _source, context: _context } => "Sources",
            Self::Explicit { my_error: _my_error, context: _context } => "Sources",
            Self::From(_0) => "Sources",
            Self::Transparent(_0) => "Sources",
            Self::DeriveMore(_0) => "Sources",
        }
    }
    fn status(&self) -> axum::http::StatusCode {
        match self {
            Self::Implicit { source: _source, context: _context } => {
                axum::http::StatusCode::INTERNAL_SERVER_ERROR
            }
            Self::Explicit { my_error: _my_error, context: _context } => {
                axum::http::StatusCode::INTERNAL_SERVER_ERROR
            }
            Self::From(_0) => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::Transparent(_0) => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::DeriveMore(_0) => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
        }
    }
    fn sub_label(&self) -> Option<&'static str> {
        match self {
            Self::Implicit { source: _source, context: _context } => Some("Implicit"),
            Self::Explicit { my_error: _my_error, context: _context } => Some("Explicit"),
            Self::From(_0) => Some("From"),
            Self::Transparent(_0) => Some("Transparent"),
            Self::DeriveMore(_0) => Some("DeriveMore"),
        }
    }
    fn context(self) -> std::collections::HashMap<String, serde_json::Value> {
        match self {
            Self::Implicit { source: _source, context: _context } => {
                std::collections::HashMap::from([
                    (
                        "context".to_owned(),
                        serde_json::to_value(_context)
                            .expect("failed to serialize context entry context"),
                    ),
                ])
            }
            Self::Explicit { my_error: _my_error, context: _context } => {
                std::collections::HashMap::from([
                    (
                        "context".to_owned(),
                        serde_json::to_value(_context)
                            .expect("failed to serialize context entry context"),
                    ),
                ])
            }
            Self::From(_0) => std::collections::HashMap::from([]),
            Self::Transparent(_0) => std::collections::HashMap::from([]),
            Self::DeriveMore(_0) => {
                std::collections::HashMap::from([
                    (
                        "0".to_owned(),
                        serde_json::to_value(_0)
                            .expect("failed to serialize context entry 0"),
                    ),
                ])
            }
        }
    }
    fn responses() -> Vec<crate::views::error::OpenApiResponse> {
        let responses = Vec::from([
            crate::views::error::OpenApiResponse {
                label: "Sources",
                sub_label: Some("Implicit"),
                message_template: Some("implicit source"),
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([
                    crate::views::error::ContextEntry {
                        key: "context",
                        schema: <String as utoipa::PartialSchema>::schema(),
                    },
                ]),
            },
            crate::views::error::OpenApiResponse {
                label: "Sources",
                sub_label: Some("Explicit"),
