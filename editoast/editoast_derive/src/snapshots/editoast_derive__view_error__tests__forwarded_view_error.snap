// Source
// -----------------------------------------------------------------------------

#[view_error(context)]
enum Wrapper {
    #[error(transparent)]
    Transparent(#[view_error] InnerError),
    #[error("own error: {detail}")]
    #[view_error(status = BAD_REQUEST)]
    Own { detail: String },
}

// Macro expansion
// -----------------------------------------------------------------------------

impl crate::views::error::ViewError for Wrapper {
    fn label(&self) -> &'static str {
        match self {
            Self::Transparent(_0) => crate::views::error::ViewError::label(_0),
            Self::Own { detail: _detail } => "wrapper",
        }
    }
    fn status(&self) -> axum::http::StatusCode {
        match self {
            Self::Transparent(_0) => crate::views::error::ViewError::status(_0),
            Self::Own { detail: _detail } => axum::http::StatusCode::BAD_REQUEST,
        }
    }
    fn sub_label(&self) -> Option<&'static str> {
        match self {
            Self::Transparent(_0) => crate::views::error::ViewError::sub_label(_0),
            Self::Own { detail: _detail } => Some("own"),
        }
    }
    fn context(self) -> std::collections::HashMap<String, serde_json::Value> {
        match self {
            Self::Transparent(_0) => crate::views::error::ViewError::context(_0),
            Self::Own { detail: _detail } => {
                std::collections::HashMap::from([
                    (
                        "detail".to_owned(),
                        serde_json::to_value(_detail)
                            .expect("failed to serialize context entry detail"),
                    ),
                ])
            }
        }
    }
    fn responses() -> Vec<crate::views::error::OpenApiResponse> {
        let mut responses = Vec::from([
            crate::views::error::OpenApiResponse {
                label: "wrapper",
                sub_label: Some("own"),
                message_template: Some("own error: {detail}"),
                status: axum::http::StatusCode::BAD_REQUEST,
                context: Vec::from([
                    crate::views::error::ContextEntry {
                        key: "detail",
                        schema: <String as utoipa::PartialSchema>::schema(),
                    },
                ]),
            },
        ]);
        responses.extend(<InnerError as crate::views::error::ViewError>::responses());
        responses
    }
}
impl utoipa::IntoResponses for Wrapper {
    fn responses() -> std::collections::BTreeMap<
        String,
        utoipa::openapi::RefOr<utoipa::openapi::response::Response>,
    > {
        <Self as crate::views::error::ViewError>::utoipa_responses().into()
    }
}
impl axum::response::IntoResponse for Wrapper {
    fn into_response(self) -> axum::response::Response {
        <Self as crate::views::error::ViewError>::into_response(self)
    }
}
