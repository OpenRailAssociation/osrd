// Source
// -----------------------------------------------------------------------------

enum Mixed {
    Unit,
    #[view_error(status = INTERNAL_SERVER_ERROR)]
    NewType(String),
    #[view_error(status = BAD_REQUEST)]
    Tuple(String, u32),
    #[view_error(status = PAYMENT_REQUIRED)]
    Rich { cause: String, fix: String, incident_id: u64 },
}

// Macro expansion
// -----------------------------------------------------------------------------

impl crate::views::error::ViewError for Mixed {
    fn label(&self) -> &'static str {
        match self {
            Self::Unit => "Mixed",
            Self::NewType(_0) => "Mixed",
            Self::Tuple(_0, _1) => "Mixed",
            Self::Rich { cause: _cause, fix: _fix, incident_id: _incident_id } => "Mixed",
        }
    }
    fn status(&self) -> axum::http::StatusCode {
        match self {
            Self::Unit => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::NewType(_0) => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::Tuple(_0, _1) => axum::http::StatusCode::BAD_REQUEST,
            Self::Rich { cause: _cause, fix: _fix, incident_id: _incident_id } => {
                axum::http::StatusCode::PAYMENT_REQUIRED
            }
        }
    }
    fn sub_label(&self) -> Option<&'static str> {
        match self {
            Self::Unit => Some("Unit"),
            Self::NewType(_0) => Some("NewType"),
            Self::Tuple(_0, _1) => Some("Tuple"),
            Self::Rich { cause: _cause, fix: _fix, incident_id: _incident_id } => {
                Some("Rich")
            }
        }
    }
    fn context(self) -> std::collections::HashMap<String, serde_json::Value> {
        match self {
            Self::Unit => std::collections::HashMap::from([]),
            Self::NewType(_0) => std::collections::HashMap::from([]),
            Self::Tuple(_0, _1) => std::collections::HashMap::from([]),
            Self::Rich { cause: _cause, fix: _fix, incident_id: _incident_id } => {
                std::collections::HashMap::from([])
            }
        }
    }
    fn responses() -> Vec<crate::views::error::OpenApiResponse> {
        let responses = Vec::from([
            crate::views::error::OpenApiResponse {
                label: "Mixed",
                sub_label: Some("Unit"),
                message_template: None,
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([]),
            },
            crate::views::error::OpenApiResponse {
                label: "Mixed",
                sub_label: Some("NewType"),
                message_template: None,
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([]),
            },
            crate::views::error::OpenApiResponse {
                label: "Mixed",
                sub_label: Some("Tuple"),
                message_template: None,
                status: axum::http::StatusCode::BAD_REQUEST,
                context: Vec::from([]),
            },
            crate::views::error::OpenApiResponse {
                label: "Mixed",
                sub_label: Some("Rich"),
                message_template: None,
                status: axum::http::StatusCode::PAYMENT_REQUIRED,
                context: Vec::from([]),
            },
        ]);
        responses
    }
}
impl utoipa::IntoResponses for Mixed {
    fn responses() -> std::collections::BTreeMap<
        String,
        utoipa::openapi::RefOr<utoipa::openapi::response::Response>,
    > {
        <Self as crate::views::error::ViewError>::utoipa_responses().into()
    }
}
impl axum::response::IntoResponse for Mixed {
    fn into_response(self) -> axum::response::Response {
        <Self as crate::views::error::ViewError>::into_response(self)
    }
}
