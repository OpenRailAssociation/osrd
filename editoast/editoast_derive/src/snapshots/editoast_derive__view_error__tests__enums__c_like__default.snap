#[view_error]
enum Color {
    Red,
    Green,
    Blue,
}

// Macro expansion
// -----------------------------------------------------------------------------

impl crate::views::error::ViewError for Color {
    fn label(&self) -> &'static str {
        match self {
            Self::Red => "Color",
            Self::Green => "Color",
            Self::Blue => "Color",
        }
    }
    fn status(&self) -> axum::http::StatusCode {
        match self {
            Self::Red => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::Green => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
            Self::Blue => axum::http::StatusCode::INTERNAL_SERVER_ERROR,
        }
    }
    fn sub_label(&self) -> Option<&'static str> {
        match self {
            Self::Red => Some("Red"),
            Self::Green => Some("Green"),
            Self::Blue => Some("Blue"),
        }
    }
    fn context(self) -> std::collections::HashMap<String, serde_json::Value> {
        match self {
            Self::Red => std::collections::HashMap::from([]),
            Self::Green => std::collections::HashMap::from([]),
            Self::Blue => std::collections::HashMap::from([]),
        }
    }
    fn responses() -> Vec<crate::views::error::OpenApiResponse> {
        let responses = Vec::from([
            crate::views::error::OpenApiResponse {
                label: "Color",
                sub_label: Some("Red"),
                message_template: None,
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([]),
            },
            crate::views::error::OpenApiResponse {
                label: "Color",
                sub_label: Some("Green"),
                message_template: None,
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([]),
            },
            crate::views::error::OpenApiResponse {
                label: "Color",
                sub_label: Some("Blue"),
                message_template: None,
                status: axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                context: Vec::from([]),
            },
        ]);
        responses
    }
}
impl utoipa::IntoResponses for Color {
    fn responses() -> std::collections::BTreeMap<
        String,
        utoipa::openapi::RefOr<utoipa::openapi::response::Response>,
    > {
        <Self as crate::views::error::ViewError>::utoipa_responses().into()
    }
}
impl axum::response::IntoResponse for Color {
    fn into_response(self) -> axum::response::Response {
        <Self as crate::views::error::ViewError>::into_response(self)
    }
}
